# ========================================================
# Frontend Environment Configuration Template
# Set these in your Vercel Project Settings > Environment Variables
# ========================================================

# Public Backend Base URL (Render Web Service)
# For local dev: http://localhost:8081
# For production: https://lostlink-backend.onrender.com
VITE_API_BASE_URL=http://localhost:8081

# Optional WebSocket STOMP Endpoint URL
# Automatically defaults to ${VITE_API_BASE_URL}/ws if omitted
# For local dev: http://localhost:8081/ws
# For production: https://lostlink-backend.onrender.com/ws
VITE_WS_URL=http://localhost:8081/ws
